FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# $PORT — Railway/Render kabi platformalar konteynerga dinamik port beradi;
# mahalliy docker-compose'da o'rnatilmagani uchun 8000 ga tushadi.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.admin.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
