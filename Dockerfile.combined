FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY app ./app
COPY migrations ./migrations
COPY scripts ./scripts
COPY alembic.ini ./
COPY docker-entrypoint-combined.sh ./
RUN chmod +x docker-entrypoint-combined.sh

ENV PATH="/app/.venv/bin:$PATH"

# glibc har bir oqim uchun alohida xotira "arenasi" ochadi; asyncio va
# asyncpg/aiohttp oqimlari bilan RSS sezilarli shishadi. 2 ta arena —
# Python konteynerlarida keng qo'llanadigan cheklov: tezlik deyarli
# o'zgarmaydi, xotira esa kamayadi. Railway RAM uchun pul oladi.
ENV MALLOC_ARENA_MAX=2
# .pyc yozilmaydi (konteyner o'zgarmas), log buferlanmaydi.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

EXPOSE 8000

# Admin panel (+ Mini App) va bot bitta konteynerda birga ishlaydi —
# docker-entrypoint-combined.sh'ga qarang (bitta-servisli deploy uchun).
CMD ["./docker-entrypoint-combined.sh"]
